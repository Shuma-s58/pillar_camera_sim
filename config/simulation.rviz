Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Color: 140; 140; 140
      Alpha: 0.35
      Reference Frame: map
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Pillars & camera
      Marker Topic:
        Value: /scene/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Queue Size: 10
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: Camera TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera Image (red=image center; blue=pillar center)
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Normalize Range: true
      Min Value: 0
      Max Value: 1
  Global Options:
    Background Color: 36; 41; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.5
      Focal Point:
        X: 1.4
        Y: 0.0
        Z: 0.6
      Pitch: 0.55
      Yaw: 0.7
      Target Frame: map
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1420
  X: 70
  Y: 70
